# Turso Database Configuration
# Remote Turso URL format: libsql://<database-name>-<org-name>.turso.io
# Or local file database: file:local.db
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=""

# Server Port
PORT=3001

# Gemini AI API (optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL
APP_URL="http://localhost:3000"

# Cross-Vercel API Load Balancing & Auto-Failover (Optional)
# Set to your peer Vercel deployment URL (e.g. https://dict-dtr-generator.vercel.app)
# to enable Round-Robin load distribution and automatic failover on 5xx / 429 / 504 timeouts
VITE_SECONDARY_API_URL=""
VITE_PEER_VERCEL_URL=""
VITE_API_LOAD_BALANCE="auto"

